# Copie este archivo como .env y ajuste los valores (el .env NO se comparte ni se sube a GitHub).

# Ruta de la base de datos SQLite (relativa a la carpeta del proyecto)
DATABASE_PATH=data/noc.db

# Receptor Syslog UDP (5514 evita requerir permisos de administrador)
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=5514

# Responsable por defecto que aparece en la auditoría
DEFAULT_OPERATOR=operador_noc

# Control de tormentas: máximo de mensajes por minuto desde una misma IP
STORM_MAX_PER_MINUTE=100

# Diferencia de la hora local con UTC (Colombia = -5)
LOCAL_UTC_OFFSET=-5

# ---------------------------------------------------------------------------
# v1.0.0 - Alertas y bot de Telegram (ver README, sección Telegram)
# ---------------------------------------------------------------------------
# 1 = enviar alertas; 0 = solo registrarlas en la base de datos
TELEGRAM_ENABLED=0
# Token que entrega @BotFather (NUNCA lo suba a GitHub)
TELEGRAM_BOT_TOKEN=
# chat_id autorizados, separados por coma (envíe /id al bot para conocer el suyo)
TELEGRAM_CHAT_IDS=
# Avisar los REVIEW con severidad igual o menor a este valor (BLOCK e incidentes nuevos siempre)
TELEGRAM_ALERT_MAX_SEVERITY=3
# Máximo de alertas por minuto (protege el chat durante una tormenta de logs)
TELEGRAM_MAX_ALERTS_PER_MINUTE=20

# Simulador en modo continuo (python simulador.py --continuo): segundos entre lotes
SIM_INTERVALO=120

# ---------------------------------------------------------------------------
# Inicio de sesión
# ---------------------------------------------------------------------------
# Clave para firmar la sesión. Si se deja vacía se genera una aleatoria en data/.secret_key
SECRET_KEY=
# Contraseñas de las cuentas iniciales (solo se usan la PRIMERA vez, cuando no hay usuarios).
# Vacías = contraseñas de demostración del README: admin / operador / monitoreo.
NOC_ADMIN_PASSWORD=
NOC_OPERADOR_PASSWORD=
NOC_MONITOREO_PASSWORD=
# Doble factor (TOTP) de la cuenta admin de demostración: 1 = activado (por defecto), 0 = sin doble factor.
NOC_ADMIN_MFA=1
# Secreto TOTP propio para la cuenta admin inicial (Base32). Vacío = el secreto de demostración del README.
NOC_ADMIN_TOTP_SECRET=

# ---------------------------------------------------------------------------
# Observabilidad
# ---------------------------------------------------------------------------
# Segundos entre sondeos de disponibilidad (ping a equipos reales, simulado a los SIM-)
OBS_PROBE_SECONDS=60
# Latencia media (ms) a partir de la cual un equipo se considera degradado
OBS_LATENCY_WARN_MS=150
# 0 = no ejecutar el sondeo periódico
OBS_POLLER=1
